# -----------------------------------------------------------------
# .gitignore for WordPress
# Bare Minimum Git
# http://ironco.de/bare-minimum-git/
# ver 20150227
#
# This file is tailored for a WordPress project 
# using the default directory structure
#
# This file specifies intentionally untracked files to ignore
# http://git-scm.com/docs/gitignore
#
# NOTES:
# The purpose of gitignore files is to ensure that certain files not
# tracked by Git remain untracked.
#
# To ignore uncommitted changes in a file that is already tracked,
# use `git update-index --assume-unchanged`.
#
# To stop tracking a file that is currently tracked,
# use `git rm --cached`
#
# Change Log:
# 20150227 Ignore hello.php plugin. props @damienfa
# 20150227 Change theme ignore to wildcard twenty*. props @Z33
# 20140606 Add .editorconfig as a tracked file
# 20140404 Ignore database, compiled, and packaged files
# 20140404 Header Information Updated
# 20140402 Initially Published
#
# -----------------------------------------------------------------

*~
.DS_Store
.svn
.cvs
*.bak
*.swp
*.log
*.sql
*.sql.gz
ehthumbs.db
Thumbs.db

# wordpress specific
/wp-config.php
/wp-content/aiowps_backups/
/wp-content/cache/
/wp-content/upgrade/
/wp-content/upgrade-temp-backup/
/wp-content/uploads/
/wp-content/.htaccess
/wp-content/wflogs/
/.htaccess

# ignore dependency directories
node_modules/

wp-content/themes/*/.config.json
wp-content/themes/*/admin/css-dev/
wp-content/themes/*/assets/css-dev/
wp-content/themes/*/assets/js-dev/
